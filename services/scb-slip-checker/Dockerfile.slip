# SCB slip verification (no embedded model — calls scb-captcha)
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY scb ./scb
COPY cmd/slip ./cmd/slip
RUN CGO_ENABLED=0 go build -tags slim -trimpath -ldflags="-s -w" -o /scb-slip ./cmd/slip

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tini
COPY --from=build /scb-slip /scb-slip
EXPOSE 8000
ENV PORT=8000
ENTRYPOINT ["/sbin/tini", "--", "/scb-slip"]
