# Captcha CNN microservice (model.bin embedded)
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY model ./model
COPY cmd/captcha ./cmd/captcha
RUN test -f model/model.bin || (echo "model/model.bin missing — run export_model.py" && exit 1)
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /scb-captcha ./cmd/captcha

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tini
COPY --from=build /scb-captcha /scb-captcha
EXPOSE 8001
ENV PORT=8001
ENTRYPOINT ["/sbin/tini", "--", "/scb-captcha"]
