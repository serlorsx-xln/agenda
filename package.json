{
  "name": "line-promotion-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" --filter \"./services/*\" dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @line/shared test && pnpm --filter @line/web test && pnpm --filter @line/worker-line test",
    "db:generate": "pnpm --filter @line/db generate",
    "db:migrate": "pnpm --filter @line/db migrate",
    "db:seed": "pnpm --filter @line/db seed",
    "db:seed-demo": "docker exec -i line-postgres-1 psql -U line -d line_promotion < scripts/seed-demo-dashboard.sql",
    "smoke": "sh scripts/integration-smoke-test.sh",
    "knip": "knip",
    "i18n:check": "node scripts/check-i18n-parity.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "knip": "^6.25.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.63.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
