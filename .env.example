# ------------------------------------------------------------------
# Agenda — Docker Compose only (everything runs in Docker).
# Copy to .env and adjust. Never commit .env.
# ------------------------------------------------------------------

# --- PostgreSQL (compose service: postgres) -----------------------
POSTGRES_USER=line
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=line_promotion

# Compose network host is the service name "postgres" (never localhost).
DATABASE_URL=postgres://line:change_me_postgres@postgres:5432/line_promotion

# --- Better Auth + public URLs (browser-facing) -------------------
# What users' browsers open (web publishes host port 3000).
# Home Docker: http://localhost:3000
# Prod + Caddy: https://your.domain.example
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change_me_generate_a_long_random_secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Internal service URLs (compose network names) ----------------
WORKER_LINE_URL=http://worker-line:4000

# --- Slip verification (external slynxslip) -----------------------
# Public URL of slynxslip (no trailing slash). Required for billing slips.
SCB_SLIP_URL=https://slynxslip-service.slynxstudio.net
# Bearer key from slynxslip project (sly_…). Never commit real keys.
SCB_API_KEY=sly_change_me
# slynxslip project slug (X-Project header). Required with SCB_API_KEY.
SCB_PROJECT=agenda

# PromptPay receive target. Required in production.
# Phone (10 digits) → credit-transfer QR via promptpay-qr.
# Biller / tax id (13–15 digits) or PROMPTPAY_TYPE=bill → Mae Manee bill QR with amount.
PROMPTPAY_ID=010753700088205
PROMPTPAY_TYPE=bill
PROMPTPAY_MERCHANT_NAME=SLYNX
# Registered Mae Manee Reference 1 (QN…) — do NOT replace with PP- payment refs.
PROMPTPAY_BILL_REF1=QN122990MB11420395G
# Raw EMV tag 62 value from the merchant QR (terminal / additional data).
PROMPTPAY_ADDITIONAL_62=07200000MgVlF7VzCJoONVp9
# 11 = static-style (recommended for Mae Manee + amount); 12 = dynamic.
PROMPTPAY_POI=11
# Optional extra slip-match ids (comma-separated), e.g. tax id + account tails.
# SLIP_RECEIVER_ACCOUNT=0753700088205

PAYMENT_TTL_MINUTES=30
PAYMENT_GRACE_MINUTES=15
SUBSCRIPTION_GRACE_DAYS=3

# Generate: openssl rand -hex 32
BILLING_WEBHOOK_SECRET=change_me_billing_webhook_secret
BILLING_OPS_TOKEN=change_me_billing_ops_token

# --- Email (Resend) -----------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Agenda <noreply@yourdomain.com>

# --- Cron / notifications -----------------------------------------
# Required in production. Generate: openssl rand -hex 32
CRON_SECRET=change_me_cron_secret

# --- Observability ------------------------------------------------
SENTRY_DSN=
# Discord embeds (slynxslip-style). Prefer Coolify env — do not commit secrets.
DISCORD_WEBHOOK_URL=
# Aliases also accepted by shared notify helper:
# NOTIFY_DISCORD_WEBHOOK=
# NOTIFY_FALLBACK_DISCORD_WEBHOOK=

# --- Production (docker-compose.prod.yml + Caddy) -----------------
APP_DOMAIN=your.domain.example
ACME_EMAIL=you@example.com

# --- Internal service auth ----------------------------------------
# Shared secret between web and worker-line. Generate: openssl rand -hex 32
INTERNAL_API_KEY=change_me_internal_api_key

# --- Worker-line --------------------------------------------------
WORKER_PORT=4000
LINE_DEVICE=ANDROIDSECONDARY
LINE_SESSION_PATH=/data/session/session.json
# AES-256 key for LINE session files (32-byte hex). Required in production.
# Generate: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=change_me_session_encryption_key
# QR login E2EE path: leave unset or "1" for WASM QR (default). Set "0" to disable.
# LINE_LTSM_QR=1
SCHEDULER_TICK_SECONDS=30

# Session pool (hibernation — many accounts, few in RAM)
MAX_HOT_SESSIONS=200
MAX_BOOT_RESTORE_SESSIONS=1
SESSION_IDLE_EVICT_MS=300000
AUTO_REPLY_CYCLE_SEC=30
AUTO_REPLY_TICK_MS=100
HIBERNATE_AFTER_AUTO_REPLY_POLL=true

# PostgreSQL connection pool size (web app; default: 10).
# PG_POOL_MAX=10
